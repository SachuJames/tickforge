# TickForge clang-tidy baseline (Day 01).
# Deliberately small: bug classes, analyzer, and safe modernizations only.
# Run with: clang-tidy <files> -p <build dir>
# See CONTRIBUTING.md for the local workflow.
#
# Disabled checks:
# - readability-identifier-length: single-letter names are idiomatic in
#   comparison operators and small test scopes; renaming adds churn.
# - misc-include-cleaner: event.hpp is the public umbrella header; forcing
#   every TU to include each sub-header directly is clutter, not hygiene.

Checks: >-
  bugprone-*,
  clang-analyzer-*,
  modernize-*,
  performance-*,
  readability-*,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -readability-magic-numbers,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -misc-include-cleaner

WarningsAsErrors: ''
HeaderFilterRegex: 'tickforge/.*'
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.ConstantCase
    value: camelBack
  # Enumerators use CamelCase (Side::Bid, EventType::NewOrder); constexpr
  # variables use camelBack (kVersion). The check needs both spelled out.
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
